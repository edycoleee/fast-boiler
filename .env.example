APP_NAME=Fast Boiler
APP_ENV=development
SECRET_KEY=change-this-to-a-random-secret
DB_URL=sqlite:///data/app.db
SESSION_COOKIE_NAME=fast_boiler_session
SESSION_MAX_AGE=86400
SESSION_SAME_SITE=lax
SESSION_HTTPS_ONLY=false
MEDIA_DIR=media/uploads
MEDIA_MAX_SIZE_BYTES=2097152
MEDIA_ALLOWED_EXTENSIONS=jpg,jpeg,png,webp,pdf,txt
MEDIA_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,application/pdf,text/plain
DRAFT_RETENTION_DAYS=30
DRAFT_MAX_PAYLOAD_CHARS=20000
DRAFT_MIN_SAVE_INTERVAL_SECONDS=2
CANVAS_MAX_PAYLOAD_CHARS=120000
THEME_COLOR_PAGE=248 250 252
THEME_COLOR_SURFACE=255 255 255
THEME_COLOR_TEXT=15 23 42
THEME_COLOR_MUTED=100 116 139
THEME_COLOR_BORDER=226 232 240
THEME_COLOR_BRAND=37 99 235
THEME_COLOR_BRAND_FOREGROUND=255 255 255
